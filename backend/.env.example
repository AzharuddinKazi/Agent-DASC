# Required
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"
# Every LLM call in the system — chat completions (llm_router.py) AND domain-pack
# knowledge base embeddings (knowledge.py) — goes through OpenRouter. Get a free key at
# https://openrouter.ai/keys — no billing needed to call ":free"-suffixed models.
OPENROUTER_API_KEY="your-openrouter-key"
SUPABASE_DB_URL="postgresql://user:pass@host:port/dbname"
DSSTAR="/absolute/path/to/DSStar"

# Optional — override a tier's OpenRouter model if a default in llm_router.py stops
# being served free (check https://openrouter.ai/api/v1/models for current ":free" ids).
# OPENROUTER_MODEL_HIGH="nvidia/nemotron-3-super-120b-a12b:free"
# OPENROUTER_MODEL_MEDIUM="openai/gpt-oss-20b:free"
# OPENROUTER_MODEL_LOW="nvidia/nemotron-nano-9b-v2:free"
# OPENROUTER_EMBED_MODEL="nvidia/nemotron-3-embed-1b:free"

# Optional — override a tier's fast-paid-profile model (see below). high/medium
# default to meta-llama/llama-3.1-8b-instruct:nitro (~$0.02/$0.04 per M input/output
# tokens; ":nitro" is OpenRouter's throughput-priority routing shortcut) — check
# https://openrouter.ai/meta-llama/llama-3.1-8b-instruct for current pricing/availability
# before relying on it. low (analyzer, sub_result_collector) isn't the speed
# bottleneck this profile exists to test, so it defaults to the same free model as the
# free profile rather than paying for it too.
# OPENROUTER_MODEL_HIGH_FAST="meta-llama/llama-3.1-8b-instruct:nitro"
# OPENROUTER_MODEL_MEDIUM_FAST="meta-llama/llama-3.1-8b-instruct:nitro"
# OPENROUTER_MODEL_LOW_FAST="nvidia/nemotron-nano-9b-v2:free"
#
# The LLM speed profile itself ("free" vs "fast_paid") is NOT set here — it's a live,
# DB-backed toggle (app_settings.llm_speed_profile), not a deployment setting. Flip it
# with:
#   curl -X POST $API_BASE/api/v1/llm_speed_profile -H "Authorization: Bearer <token>" \
#        -H "Content-Type: application/json" -d '{"profile": "fast_paid"}'
# It applies to the very next LLM call, no restart needed, and always defaults back to
# "free" (no billing required) if never toggled or if the DB is unreachable.

# Optional — CORS origins the backend accepts, comma-separated.
ALLOWED_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"

# Optional — structured logging (see observability.py). One of DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL="INFO"

# Optional — error tracking. Leave unset to disable entirely (no external calls made).
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.0"

# Optional — max pipeline runs executing at once (each spins up 2GB-capped Docker sandbox
# containers at their Executor step). Extra submissions still get an immediate 202 and queue.
MAX_CONCURRENT_PIPELINES="10"
