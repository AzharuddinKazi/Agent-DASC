# Required
#
# These point at the local docker-compose `postgres`/`postgrest` services, not hosted
# Supabase — auth is dropped entirely (single trusted local machine, no public exposure).
# The two keys are JWTs signed with PGRST_JWT_SECRET (docker-compose.yml) carrying
# `{"role": "dsstar_app"}`, so every request PostgREST sees resolves to that one role
# regardless of which "user" nominally made it. Regenerate if PGRST_JWT_SECRET changes:
#   uv run python -c "import jwt; print(jwt.encode({'role': 'dsstar_app'}, '<PGRST_JWT_SECRET value>', algorithm='HS256'))"
# (See TASKS.md "The auth-removal mechanism" — leaving PGRST_JWT_SECRET unset, the
# original plan, doesn't work: supabase-py always sends an Authorization: Bearer header,
# which makes PostgREST 500 with "Server lacks JWT secret" if none is configured.)
#
# Hostnames: use the docker-compose service names (`postgrest`, `postgres`) when the
# backend itself runs as a docker-compose service — that's the normal way to run this app.
# Use `localhost` only when running the backend directly on the host (e.g. `uv run pytest`,
# or `uv run uvicorn main:app` outside docker-compose) against `docker compose up postgres
# postgrest` still running with their ports published.
SUPABASE_URL="http://postgrest-gateway:3000"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiZHNzdGFyX2FwcCJ9.mTFzXsvpK3U8rWiwFX9VSRp6hNKYzMc8c9hI8SYryEM"
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiZHNzdGFyX2FwcCJ9.mTFzXsvpK3U8rWiwFX9VSRp6hNKYzMc8c9hI8SYryEM"
# Every LLM call in the system — chat completions (llm_router.py) AND domain-pack
# knowledge base embeddings (knowledge.py) — goes through OpenRouter. Get a free key at
# https://openrouter.ai/keys — no billing needed to call ":free"-suffixed models.
OPENROUTER_API_KEY="your-openrouter-key"
# Direct Postgres connection for LangGraph's AsyncPostgresSaver checkpointer — this one
# actually needs a real Postgres wire connection, not PostgREST, so it points straight at
# the `postgres` docker-compose service (not `postgrest`, and not SUPABASE_URL above).
# Password must match POSTGRES_PASSWORD (docker-compose.yml, defaults to dsstar_local_dev).
SUPABASE_DB_URL="postgresql://postgres:dsstar_local_dev@postgres:5432/postgres"
DSSTAR="/absolute/path/to/DSStar"

# Optional — override a tier's OpenRouter model for the free profile, if a default in
# llm_router.py stops being served free (check https://openrouter.ai/api/v1/models for
# current ":free" ids). "coder" is a fourth pseudo-tier — coder/debugger/finalizer use
# it instead of "high" regardless of their nominal AGENT_TIERS entry (see llm_router.py's
# _CODE_AGENTS for why).
# OPENROUTER_MODEL_HIGH="nvidia/nemotron-3-ultra-550b-a55b:free"
# OPENROUTER_MODEL_MEDIUM="nvidia/nemotron-3-nano-30b-a3b:free"
# OPENROUTER_MODEL_LOW="nvidia/nemotron-nano-9b-v2:free"
# OPENROUTER_MODEL_CODER_FREE="nvidia/nemotron-3-ultra-550b-a55b:free"
# OPENROUTER_EMBED_MODEL="nvidia/nemotron-3-embed-1b:free"

# Optional — override a tier's fast-paid-profile model (see below). Researched and
# assigned 2026-08-23 (see llm_router.py for the reasoning per tier) — check
# https://openrouter.ai/models for current pricing/availability before relying on
# these, both change. low (analyzer, sub_result_collector) isn't the speed bottleneck
# this profile exists to test, so it defaults to the same free model as the free
# profile rather than paying for it too.
# OPENROUTER_MODEL_HIGH_FAST="qwen/qwen3-235b-a22b-2507"
# OPENROUTER_MODEL_MEDIUM_FAST="google/gemini-2.5-flash-lite"
# OPENROUTER_MODEL_LOW_FAST="nvidia/nemotron-nano-9b-v2:free"
# OPENROUTER_MODEL_CODER_FAST="qwen/qwen3-coder-next"

# Optional — manual pin for coder/debugger/finalizer, e.g. a local Ollama tag. Takes
# priority over both OPENROUTER_MODEL_CODER_FREE and _FAST above regardless of which
# speed profile is active — unlike those two, this one has no _FREE/_FAST suffix on
# purpose, since a manual pin shouldn't get silently swapped out by a profile toggle.
# OPENROUTER_MODEL_CODER="qwen2.5-coder:14b"
#
# The LLM speed profile itself ("free" vs "fast_paid") is NOT set here — it's a live,
# DB-backed toggle (app_settings.llm_speed_profile), not a deployment setting. Flip it
# with:
#   curl -X POST $API_BASE/api/v1/llm_speed_profile -H "Authorization: Bearer <token>" \
#        -H "Content-Type: application/json" -d '{"profile": "fast_paid"}'
# It applies to the very next LLM call, no restart needed, and always defaults back to
# "free" (no billing required) if never toggled or if the DB is unreachable.

# Optional — CORS origins the backend accepts, comma-separated.
ALLOWED_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"

# Required for real Google sign-in (see TASKS.md "Google OAuth login + Admin Control
# Panel"). Create at https://console.cloud.google.com/apis/credentials — "OAuth client ID",
# type "Web application", authorized JavaScript origin matching the frontend's URL (e.g.
# http://localhost:5174). No client *secret* needed — Google Identity Services verifies
# server-side against Google's public keys, not a secret round-trip.
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Required for real Google sign-in — signs this app's own session cookie (HS256 JWT).
# Any random string; generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY="change-me-to-a-random-secret"

# Who gets admin access after signing in with Google — comma-separated emails, case
# insensitive. Sign-up itself is open to any Google account; this only gates the admin
# panel. Recomputed on every login, so changing this takes effect on that user's next
# sign-in with no DB edit needed.
ADMIN_EMAILS="you@example.com"

# Optional — structured logging (see observability.py). One of DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL="INFO"

# Optional — error tracking. Leave unset to disable entirely (no external calls made).
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.0"

# Optional — max pipeline runs executing at once (each spins up a Docker sandbox
# container, capped at SANDBOX_MEMORY_LIMIT below, at their Executor step). Extra
# submissions still get an immediate 202 and queue.
MAX_CONCURRENT_PIPELINES="10"

# Optional — memory cap (Docker `--memory`) per sandbox container running LLM-generated
# analysis code. A ceiling Docker enforces if hit, not a reservation made upfront, so
# concurrent tasks don't pre-allocate MAX_CONCURRENT_PIPELINES * this — but that product
# is the real worst case, so size the two together against your machine's actual RAM
# (e.g. to keep the worst case at or under 20GB on a 32GB machine: 5 * 4g).
SANDBOX_MEMORY_LIMIT="8g"
