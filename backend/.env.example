# Required
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"
GEMINI_API_KEY="your-gemini-key"
SUPABASE_DB_URL="postgresql://user:pass@host:port/dbname"
DSSTAR="/absolute/path/to/DSStar"

# Optional — CORS origins the backend accepts, comma-separated.
ALLOWED_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"

# Optional — structured logging (see observability.py). One of DEBUG/INFO/WARNING/ERROR.
LOG_LEVEL="INFO"

# Optional — error tracking. Leave unset to disable entirely (no external calls made).
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.0"

# Optional — max pipeline runs executing at once (each spins up 2GB-capped Docker sandbox
# containers at their Executor step). Extra submissions still get an immediate 202 and queue.
MAX_CONCURRENT_PIPELINES="10"
