# Used by docker-compose.yml for variable substitution (the frontend build args, and
# ALLOWED_ORIGINS for the backend). The backend container's own runtime secrets come from
# backend/.env via env_file: — this file is only for values docker-compose itself needs to
# read before containers start.
#
# Copy to .env at the repo root and fill in real values. Never commit the real .env.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of origins the backend will accept CORS requests from.
ALLOWED_ORIGINS=http://localhost:5174

# Where the frontend should reach the backend API. Baked into the frontend build at build
# time (Vite env vars are compile-time, not runtime) — set this to wherever the backend
# container is actually reachable from a browser.
VITE_API_BASE=http://localhost:8000
