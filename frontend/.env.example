# Copy to frontend/.env and fill in. Read directly by Vite at build/dev time — no build
# ARGs involved (docker-compose.yml's frontend service deliberately declares none; see the
# comment there for why that used to silently break this).

# Backend API base URL.
VITE_API_BASE=http://localhost:8000

# Same Client ID as backend/.env's GOOGLE_CLIENT_ID — the frontend needs it to render
# Google's Sign In button, the backend needs it to verify the token that button produces.
# Not sensitive (it's the public half of the OAuth pair). Create one at
# https://console.cloud.google.com/apis/credentials — OAuth client ID, Web application,
# authorized JS origin matching wherever this frontend is served from (e.g.
# http://localhost:5174 for local dev).
VITE_GOOGLE_CLIENT_ID=
